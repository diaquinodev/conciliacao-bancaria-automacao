# =================================================================
# CONFIGURAÇÃO DE CREDENCIAIS - AMBIENTE DE CONCILIAÇÃO BANCÁRIA
# =================================================================
# ATENÇÃO: Nunca comite credenciais reais no repositório Git!
# Copie este arquivo para .env e preencha com as credenciais corporativas.

# 1. CREDENCIAIS DOS 8 BANCOS CORPORATIVOS (OAuth 2.0)
BB_CLIENT_ID=
BB_CLIENT_SECRET=
BB_API_URL=https://api.bb.com.br/v1

BRADESCO_CLIENT_ID=
BRADESCO_CLIENT_SECRET=
BRADESCO_API_URL=https://api.bradesco.com.br/v1

ITAU_CLIENT_ID=
ITAU_CLIENT_SECRET=
ITAU_API_URL=https://api.itau.com.br/v1

SANTANDER_CLIENT_ID=
SANTANDER_CLIENT_SECRET=
SANTANDER_API_URL=https://api.santander.com.br/v1

CAIXA_CLIENT_ID=
CAIXA_CLIENT_SECRET=
CAIXA_API_URL=https://api.caixa.com.br/v1

HSBC_CLIENT_ID=
HSBC_CLIENT_SECRET=
HSBC_API_URL=https://api.hsbc.com.br/v1

SICREDI_CLIENT_ID=
SICREDI_CLIENT_SECRET=
SICREDI_API_URL=https://api.sicredi.com.br/v1

INTER_CLIENT_ID=
INTER_CLIENT_SECRET=
INTER_API_URL=https://api.inter.com.br/v1

# 2. INTELIGÊNCIA ARTIFICIAL (Anthropic Claude API)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# 3. BANCO DE DADOS RELACIONAL (SQL Server / Azure SQL)
SQL_SERVER_HOST=sql-viagens-corp.database.windows.net
SQL_DATABASE=CONCILIACAO_BANCARIA
SQL_USER=app_conciliacao_service
SQL_PASSWORD=

# 4. OBSERVALIBIDADE & LOGS
LOG_LEVEL=INFO
CORRELATION_ID_PREFIX=VIAGENS_CORP
